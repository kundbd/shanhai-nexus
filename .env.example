# Use http://localhost:3000 for a local canonical origin.
SITE_URL=https://shanhainexus.com
# Host port used by Docker Compose (loopback only).
APP_PORT=3000
# Use an absolute path in Docker. For npm dev, data/directory.sqlite is the default.
DB_PATH=data/directory.sqlite
# Enable only on the audited loopback-only standalone server behind direct Nginx.
GEO_IP_MODE=off
# An absolute path to the DB-IP Country Lite MMDB file.
GEO_IP_DB=
# Leave these blank to disable the editor login. Use the public HTTPS origin on VPS.
ADMIN_ORIGIN=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# FILEBOX supplies registration, email verification and account authentication.
FILEBOX_ACCOUNT_ORIGIN=https://account-test.unziptool.cn
# Generate a separate 32-byte hex key for encrypting provider session tokens.
MEMBER_SESSION_KEY=
# Optional FILEBOX user ID for the private developer badge in /account.
MEMBER_DEVELOPER_SUBJECT=
# Optional editorial draft service. The application does not call a model for search.
EDITOR_AI_ENDPOINT=
EDITOR_AI_TOKEN=
# Server-only DeepSeek Chat moderation. When the dedicated key is blank, uses DEEPSEEK_API_KEY.
DSH_MODERATION_ENABLED=0
DSH_MODERATION_API_KEY=
DSH_MODERATION_MODEL=deepseek-flash
# Maximum daily review requests, UTC. 0 holds text for manual review.
DSH_MODERATION_DAILY_LIMIT=120
# Optional. Enable Brave discovery only after confirming plan storage rights.
DISCOVERY_BRAVE_TOKEN=
DISCOVERY_BRAVE_STORAGE_RIGHTS=0
DEEPSEEK_API_KEY=
# Daily Search API request attempts per directory database, in UTC. 0 disables requests.
DEEPSEEK_DISCOVERY_DAILY_LIMIT=5
# Optional per-service proxy URLs, for example http://127.0.0.1:7897 or socks5://127.0.0.1:7897.
# Blank means direct. Use https:// only for a proxy endpoint that accepts TLS.
DEEPSEEK_PROXY=
MERCHANT_PROXY=
# Docker enables the five-hour directory refresh worker by default. Set to 0 to pause it.
DIRECTORY_REFRESH_ENABLED=1
# Requests per second across the merchant checks. Valid values 1–12.
MERCHANT_REFRESH_RATE=6
